class DataExtraction:

    def __init__(self):
        self.chrome_options = webdriver.ChromeOptions()
        self.chrome_options.add_experimental_option("detach", True)
        # self.chrome_options.add_argument('--headless')
        ## Kept getting a time-out error for when trying to run a new URL in webdriver, so I added this ChromeDriverManager Clas:
        self.service = Service(ChromeDriverManager().install())
        self.driver = webdriver.Chrome(options=self.chrome_options, service=self.service)
        self.wait = WebDriverWait(self.driver, 5)


    def get_website(self, url):

        try:
            self.driver.get(url)
            time.sleep(2)
        except MaxRetryError:
            self.driver.quit()
            self.driver.get(url)
            time.sleep(2)

        # Input Login Details:
        email = self.wait.until(ec.presence_of_element_located((By.NAME, "vendor_email")))
        email.send_keys(EMAIL)
        password = self.wait.until(ec.presence_of_element_located((By.NAME, "vendor_password")))
        password.send_keys(PASSWORD)

        # Enter pressing:
        submit_login = self.driver.find_element(By.NAME, "Submit")
        submit_login.click()

        ## After login, enter sales and generate days sales:
        nav_to_sales = self.wait.until(ec.presence_of_element_located((By.XPATH, "/html/body/table[1]/tbody/tr[2]/td/a[1]")))
        nav_to_sales.click()




    def open_shops(self, shop_num):

        shop_dd = self.driver.find_element(By.XPATH, "/html/body/table[2]/tbody/tr[6]/td[3]/select")
        shop_dd.click()
        shop_selector = self.driver.find_element(By.XPATH, f"/html/body/table[2]/tbody/tr[6]/td[3]/select/option[{shop_num}]")
        shop_selector.click()

        # Submit request:
        submit_year_data = self.driver.find_element(By.NAME, "submit")
        submit_year_data.click()
        return self.scrape_data()

    def scrape_data(self):
        ## Now time to scrape the data:
        all_data = []

        data_length = len(self.driver.find_elements(By.XPATH, value=f"/html/body/table[2]/tbody/tr[9]/td/table/tbody/tr"))

        for num in range(2, data_length):
            tr_data = self.driver.find_elements(By.XPATH, value=f"/html/body/table[2]/tbody/tr[9]/td/table/tbody/tr[{num}]/td")
            td_data_list = [item.text for item in tr_data]
            all_data.append(td_data_list)
        print(all_data)
        headings = self.driver.find_elements(By.XPATH, value=f"/html/body/table[2]/tbody/tr[9]/td/table/tbody/tr[2]/td")
        headings_list = [item.text.split(" ")[1] for item in headings]

        ## Add data to workable dictionary:
        data = {f"{all_data.index(i)}": {head: i[headings_list.index(head)] for head in headings_list} for i in all_data}
        print(data)

        ## Formate date from MM/DD/YYYY to DD/MM/YYYY:
        for item in range(0, len(all_data)):
            date_strip = dt.strptime(data[f"{item}"]["Date"].split(" ")[0], "%m/%d/%Y")
            formated_date = date_strip.strftime("%d/%m/%Y")
            data[f"{item}"]["Date"] = formated_date

        return data

    def log_out(self):
        log_out = self.driver.find_element(By.XPATH, value="/html/body/table[1]/tbody/tr[2]/td/a[6]")
        log_out.click()
        self.driver.quit()
