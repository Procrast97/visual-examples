FILE_PATH = "Sales_Data.xlsx"

class ExcelCreation:

    def __init__(self):
        pass

    def create_excelsheet(self, data, shop_name):
        # EXEPTION CATCH - Keep getting a "data" not defined error:
        try:
            formated_data = pd.DataFrame(data)
            horizontal_form = formated_data.T
        except NameError:
            print("A 'NameError' has occurred, trying again...")
            formated_data = pd.DataFrame(data)
            horizontal_form = formated_data.T

            # ## Selecting the shop names for saving the data:
            # shop_name = SHOPS[loops][shops - 1]

            ## Sort data into a CSV file (excel):
            formated_data = pd.DataFrame(horizontal_form)

            ## Check if file exists:
            if os.path.exists(FILE_PATH):
                book = load_workbook(filename=FILE_PATH)

                ##Check if sheets exist:
                if shop_name in book.sheetnames:
                    ## If the sheet already exists, then you will load the sheet data to locate the last row containing data:
                    existing_data = pd.read_excel(FILE_PATH, sheet_name=shop_name)
                    start_column = len(existing_data.columns) + 2
                else:
                    ## Is the sheet doesn't exist we will make the last row equal to '0':
                    start_column = 0

                with pd.ExcelWriter(FILE_PATH, engine="openpyxl", mode='a', if_sheet_exists="overlay") as writer:
                    formated_data.to_excel(writer, sheet_name=f"{shop_name}", startcol=start_column, index=False,
                                           header=True)

            ## If the file_path doesn't exist:
            else:
                with pd.ExcelWriter(FILE_PATH, engine="openpyxl") as writer:
                    formated_data.to_excel(writer, sheet_name=f"{shop_name}", index=False)

            print(f"Completed! Your sheet '{shop_name}' has been updated!")






